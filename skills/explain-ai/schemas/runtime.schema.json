{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gravityinnovations.github.io/explore-ai/schemas/runtime.schema.json",
  "title": "Runtime",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/actionName"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "cameraModes": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/cameraMode"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/slug"
          },
          "actions": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/actionName"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "actions"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "performanceBudgets": {
      "type": "object",
      "properties": {
        "devicePixelRatio": { "type": "number", "exclusiveMinimum": 0 },
        "drawCalls": { "type": "integer", "minimum": 0 },
        "visibleTriangles": { "type": "integer", "minimum": 0 },
        "maxTextureDimension": { "type": "integer", "minimum": 1 },
        "textureMemoryBytes": { "type": "integer", "minimum": 0 },
        "shadowLights": { "type": "integer", "minimum": 0 },
        "particles": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "budgetOverrideReason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "actions",
    "cameraModes",
    "components"
  ],
  "additionalProperties": false
}
