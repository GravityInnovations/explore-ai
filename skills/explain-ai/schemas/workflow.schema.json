{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gravityinnovations.github.io/explore-ai/schemas/workflow.schema.json",
  "title": "DesignerWorkflow",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.2.0"
    },
    "session": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "stage": {
      "enum": [
        "interview",
        "brief-review",
        "design",
        "qa",
        "design-review",
        "accepted"
      ]
    },
    "decisions": {
      "type": "object",
      "properties": {
        "audience": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "enum": [
                "user",
                "delegated",
                "proposed"
              ]
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "value",
            "source",
            "evidence"
          ],
          "additionalProperties": false
        },
        "brand": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "enum": [
                "user",
                "delegated",
                "proposed"
              ]
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "value",
            "source",
            "evidence"
          ],
          "additionalProperties": false
        },
        "typography": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "enum": [
                "user",
                "delegated",
                "proposed"
              ]
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "value",
            "source",
            "evidence"
          ],
          "additionalProperties": false
        },
        "palette": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "enum": [
                "user",
                "delegated",
                "proposed"
              ]
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "value",
            "source",
            "evidence"
          ],
          "additionalProperties": false
        },
        "layout": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "enum": [
                "user",
                "delegated",
                "proposed"
              ]
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "value",
            "source",
            "evidence"
          ],
          "additionalProperties": false
        },
        "visuals": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "enum": [
                "user",
                "delegated",
                "proposed"
              ]
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "value",
            "source",
            "evidence"
          ],
          "additionalProperties": false
        },
        "motion": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "enum": [
                "user",
                "delegated",
                "proposed"
              ]
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "value",
            "source",
            "evidence"
          ],
          "additionalProperties": false
        },
        "accessibility": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "enum": [
                "user",
                "delegated",
                "proposed"
              ]
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "value",
            "source",
            "evidence"
          ],
          "additionalProperties": false
        },
        "constraints": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "enum": [
                "user",
                "delegated",
                "proposed"
              ]
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "value",
            "source",
            "evidence"
          ],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "pendingChoice": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "key": {
              "enum": ["audience", "brand", "typography", "palette", "layout", "visuals", "motion", "accessibility", "constraints"]
            },
            "mode": {
              "enum": ["recommendation", "options", "clarification"]
            },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "value": { "type": "string", "minLength": 1 },
                  "rationale": { "type": "string", "minLength": 1 }
                },
                "required": ["id", "value", "rationale"],
                "additionalProperties": false
              },
              "maxItems": 4,
              "uniqueItems": true
            }
          },
          "required": ["key", "mode", "options"],
          "additionalProperties": false,
          "allOf": [
            { "if": { "properties": { "mode": { "const": "recommendation" } } }, "then": { "properties": { "options": { "type": "array", "minItems": 1, "maxItems": 1 } } } },
            { "if": { "properties": { "mode": { "const": "options" } } }, "then": { "properties": { "options": { "type": "array", "minItems": 2, "maxItems": 4 } } } },
            { "if": { "properties": { "mode": { "const": "clarification" } } }, "then": { "properties": { "options": { "type": "array", "maxItems": 0 } } } }
          ]
        },
        { "type": "null" }
      ]
    },
    "candidates": {
      "type": "object",
      "properties": {
        "audience": { "$ref": "#/$defs/candidateList" },
        "brand": { "$ref": "#/$defs/candidateList" },
        "typography": { "$ref": "#/$defs/candidateList" },
        "palette": { "$ref": "#/$defs/candidateList" },
        "layout": { "$ref": "#/$defs/candidateList" },
        "visuals": { "$ref": "#/$defs/candidateList" },
        "motion": { "$ref": "#/$defs/candidateList" },
        "accessibility": { "$ref": "#/$defs/candidateList" },
        "constraints": { "$ref": "#/$defs/candidateList" }
      },
      "additionalProperties": false
    },
    "brief": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "fingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "agreement": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "fingerprint": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "statement": {
                      "type": "string",
                      "minLength": 1
                    },
                    "at": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "fingerprint",
                    "statement",
                    "at"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "summary",
            "fingerprint",
            "agreement"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "preview": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1
            },
            "paths": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/relativePath"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "fingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "url",
            "paths",
            "fingerprint"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "qa": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check": {
            "enum": [
              "contracts",
              "desktop",
              "mobile",
              "labels",
              "keyboard",
              "motion",
              "fallback",
              "app-check"
            ]
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "not-applicable"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "check",
          "result",
          "evidence",
          "fingerprint"
        ],
        "additionalProperties": false
      }
    },
    "feedback": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "stage",
          "note",
          "at"
        ],
        "additionalProperties": false
      }
    },
    "acceptance": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "fingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "statement": {
              "type": "string",
              "minLength": 1
            },
            "at": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "fingerprint",
            "statement",
            "at"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "session",
    "revision",
    "stage",
    "decisions",
    "pendingChoice",
    "candidates",
    "brief",
    "preview",
    "qa",
    "feedback",
    "acceptance"
  ],
  "additionalProperties": false,
  "$defs": {
    "candidateList": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 },
          "sourceKey": { "enum": ["audience", "brand", "typography", "palette", "layout", "visuals", "motion", "accessibility", "constraints"] }
        },
        "required": ["value", "evidence", "sourceKey"],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 4
    }
  }
}
