{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gravityinnovations.github.io/explore-ai/schemas/asset-index.schema.json",
  "title": "AssetIndex",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      },
      "minItems": 0
    }
  },
  "required": [
    "schemaVersion",
    "assets"
  ],
  "additionalProperties": false,
  "$defs": {
    "asset": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/slug"
        },
        "type": {
          "type": "string",
          "enum": [
            "model",
            "image",
            "texture",
            "audio",
            "component"
          ]
        },
        "path": {
          "$ref": "common.schema.json#/$defs/relativePath"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "semanticTargets": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/target"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "type",
        "path",
        "tags",
        "description",
        "license",
        "source"
      ],
      "additionalProperties": false
    }
  }
}
