{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gravityinnovations.github.io/explore-ai/schemas/asset-index.schema.json",
  "title": "AssetIndex",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      },
      "minItems": 0
    }
  },
  "required": [
    "schemaVersion",
    "assets"
  ],
  "additionalProperties": false,
  "$defs": {
    "asset": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/slug"
        },
        "type": {
          "type": "string",
          "enum": [
            "model",
            "image",
            "texture",
            "audio",
            "component"
          ]
        },
        "path": {
          "$ref": "common.schema.json#/$defs/relativePath"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "provenanceStatus": {
          "type": "string",
          "enum": [
            "original",
            "permissive",
            "customer-supplied",
            "reference-only",
            "restricted",
            "unknown"
          ]
        },
        "redistribution": {
          "type": "string",
          "enum": [
            "allowed",
            "attribution-required",
            "denied"
          ]
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        },
        "authorizationEvidence": {
          "type": "string",
          "minLength": 1
        },
        "semanticTargets": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/target"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "type",
        "path",
        "tags",
        "description",
        "source",
        "provenanceStatus",
        "redistribution"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "provenanceStatus": {
                "enum": ["permissive"]
              }
            },
            "required": ["provenanceStatus"]
          },
          "then": {
            "properties": {
              "license": { "type": "string", "minLength": 1 },
              "attribution": { "type": "string", "minLength": 1 }
            },
            "required": ["license", "attribution"]
          }
        },
        {
          "if": {
            "properties": {
              "redistribution": {
                "const": "attribution-required"
              }
            },
            "required": ["redistribution"]
          },
          "then": {
            "properties": {
              "license": { "type": "string", "minLength": 1 },
              "attribution": { "type": "string", "minLength": 1 }
            },
            "required": ["license", "attribution"]
          }
        },
        {
          "if": {
            "properties": {
              "provenanceStatus": {
                "const": "customer-supplied"
              },
              "redistribution": {
                "enum": ["allowed", "attribution-required"]
              }
            },
            "required": ["provenanceStatus", "redistribution"]
          },
          "then": {
            "properties": {
              "authorizationEvidence": { "type": "string", "minLength": 1 }
            },
            "required": ["authorizationEvidence"]
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
