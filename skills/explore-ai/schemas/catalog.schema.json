{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gravityinnovations.github.io/explore-ai/schemas/catalog.schema.json",
  "title": "Catalog",
  "type": "object",
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/version" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "level": { "$ref": "common.schema.json#/$defs/slug" },
          "subject": { "$ref": "common.schema.json#/$defs/slug" },
          "topicKey": { "$ref": "common.schema.json#/$defs/slug" },
          "slug": { "$ref": "common.schema.json#/$defs/slug" },
          "lessonId": { "type": "string", "minLength": 1 },
          "route": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+/[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 }
        },
        "required": ["level", "subject", "topicKey", "slug", "lessonId", "route", "title"],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": ["schemaVersion", "entries"],
  "additionalProperties": false
}
